# First National Collegiate Bank of AZ - Environment Configuration
# Copy this file to .env and update with your values

# Flask Environment
FLASK_ENV=production
FLASK_APP=app.py
SECRET_KEY=your-secret-key-here-use-os-urandom-32-hex

# Database
DATABASE_URL=postgresql://bankuser:secure_password@localhost:5432/firstnationalbank

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here-use-os-urandom-32-hex

# Redis (for rate limiting)
REDIS_URL=redis://localhost:6379/0

# Encryption
ENCRYPTION_KEY=your-fernet-encryption-key-here

# CORS Origins (comma-separated)
CORS_ORIGINS=https://firstnationalaz.bank,https://app.firstnationalaz.bank

# Logging
LOG_LEVEL=INFO

# Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@firstnationalaz.bank
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=First National Bank <noreply@firstnationalaz.bank>

# Monitoring (optional)
SENTRY_DSN=your-sentry-dsn-here

# Production Settings
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=30
